# Monochrome Test: generated from this theme's Foot palette by oldbook-theme sync.
# Edit the Foot colours, then rerun sync; this file is derived.
copy-on-select = clipboard
font-family = JetBrainsMono Nerd Font
font-size = 9.5
command = /bin/zsh
window-padding-x = 6
window-padding-y = 6
window-decoration = server
window-theme = dark
custom-shader = ~/.config/ghostty/shaders/warm-bloom.glsl
custom-shader = ~/.config/ghostty/shaders/cursor-smear.glsl
custom-shader-animation = true

background = 000000
foreground = ffffff
selection-background = ffffff
selection-foreground = ffffff
background-opacity = 0.78
cursor-text = 000000
cursor-color = ffffff

palette = 0=#000000
palette = 1=#ffffff
palette = 2=#ffffff
palette = 3=#ffffff
palette = 4=#ffffff
palette = 5=#ffffff
palette = 6=#ffffff
palette = 7=#ffffff
palette = 8=#ffffff
palette = 9=#ffffff
palette = 10=#ffffff
palette = 11=#ffffff
palette = 12=#ffffff
palette = 13=#ffffff
palette = 14=#ffffff
palette = 15=#ffffff
