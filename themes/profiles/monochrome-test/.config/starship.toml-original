add_newline = false
format = "$username$hostname$directory${custom.fossil}$git_branch$git_status$cmd_duration$line_break$character"

[username]
show_always = true
style_user = "bold #ffffff"
style_root = "bold #ffffff"
format = "[$user]($style)"

[hostname]
ssh_only = false
style = "#ffffff"
format = "[@$hostname]($style) "

[directory]
style = "bold #ffffff"
truncation_length = 4
truncate_to_repo = false
read_only = " 󰌾"

[git_branch]
symbol = "󰘬 "
style = "#ffffff"

[git_status]
style = "#ffffff"

[cmd_duration]
min_time = 500
format = " [󱎫 $duration]($style)"
style = "#ffffff"

[character]
success_symbol = "[❯](bold #ffffff)"
error_symbol = "[❯](bold #ffffff)"

[custom.fossil]
command = "fossil branch current"
when = "fossil info >/dev/null 2>&1"
format = " [󰜘 $output]($style)"
style = "bold #ffffff"
shell = ["sh"]
