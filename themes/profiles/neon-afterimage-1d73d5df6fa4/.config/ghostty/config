# Neon Afterimage: generated from this theme's Foot palette by oldbook-theme sync.
# Edit the Foot colours, then rerun sync; this file is derived.
copy-on-select = clipboard
font-family = JetBrainsMono Nerd Font
font-size = 9.5
command = /bin/zsh
window-padding-x = 10
window-padding-y = 10
window-decoration = server
window-theme = dark
custom-shader = ~/.config/ghostty/shaders/warm-bloom.glsl
custom-shader = ~/.config/ghostty/shaders/cursor-smear.glsl
custom-shader-animation = true

background = 100D1C
foreground = E8E4F1
selection-background = 403c4b
selection-foreground = ede9f4
background-opacity = 0.9
cursor-text = 100D1C
cursor-color = 5DE4FF

palette = 0=#100D1C
