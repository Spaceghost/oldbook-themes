# Copper Hush: generated from this theme's Foot palette by oldbook-theme sync.
# Edit the Foot colours, then rerun sync; this file is derived.
copy-on-select = clipboard
font-family = JetBrainsMono Nerd Font
font-size = 9.5
command = /bin/zsh
window-padding-x = 10
window-padding-y = 10
window-decoration = server
window-theme = dark
custom-shader = ~/.config/ghostty/shaders/warm-bloom.glsl
custom-shader = ~/.config/ghostty/shaders/cursor-smear.glsl
custom-shader-animation = true

background = 101D24
foreground = E8D9B8
selection-background = 404645
selection-foreground = ede1c6
background-opacity = 0.88
cursor-text = 101D24
cursor-color = D56B4B

